      "алкоголь"
    ],
    "steps": [
      {
        "title": "Проверить привязку комплекта к блюду",
        "body": "Для алкогольных позиций комплект обязателен: без него касса не может сопоставить марку с блюдом. Откройте карточку блюда и убедитесь, что комплект привязан."
      },
      {
        "title": "Проверить кран (для пива)",
        "body": "Если позиция пивная — проверьте назначение крана. Пивная позиция без крана не списывает марку при пробитии."
      },
      {
        "title": "Запросить порционные остатки по Справке Б",
        "body": "Откройте запрос порционных остатков ЕГАИС по Справке Б и найдите нужную марку."
      },
      {
        "title": "Проверить цвет марки в запросе",
        "body": "Белая марка — доступна и может быть пробита. Серая марка — уже списана в ЕГАИС и не может быть пробита повторно."
      },
      {
        "title": "Оформить акт списания порционных остатков",
        "body": "Если марка серая — оформите акт списания порционных остатков, чтобы скорректировать учёт, затем проверьте комплект и кран."
      }
    ],
    "commonErrors": [
      {
        "error": "Марка серая в запросе остатков",
        "reason": "Марка уже списана в ЕГАИС при продаже розлива или прошлом акте списания.",
        "solution": "Оформить акт списания порционных остатков и проверить привязку комплекта и крана."
      },
      {
        "error": "Комплект не привязан к блюду",
        "reason": "Без комплекта касса не связывает марку с блюдом — марка не списывается.",
        "solution": "Привязать комплект к блюду при настройке меню."
      },
      {
        "error": "Пивная позиция без крана",
        "reason": "Для пива обязательно назначение крана, иначе списание марки не работает.",
        "solution": "Назначить кран в настройках пивной позиции."
      }
